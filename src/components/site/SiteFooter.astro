---
import Logo from "./Logo.astro";
import CtaButton from "./CtaButton.astro";
import lightLogo from "@/assets/brand/rightskit-logo-light.svg?raw";

const blurb =
  "Our data tools and network of trusted partners help rightsholders uncover the true value of their catalog. Take control of your data and start unlocking untapped revenue today.";
---

<footer class="relative overflow-hidden bg-[#1b1d2a] text-on-dark">
  <div class="container-site pt-12 lg:pt-20">
    <div class="relative grid grid-cols-1 lg:grid-cols-2">
      <!-- vertical lines: far-left, middle, far-right -->
      <div class="pointer-events-none absolute inset-y-0 left-0 hidden w-px bg-white/12 lg:block"></div>
      <div class="pointer-events-none absolute inset-y-0 left-1/2 hidden w-px bg-white/12 lg:block"></div>
      <div class="pointer-events-none absolute inset-y-0 right-0 hidden w-px bg-white/12 lg:block"></div>

      <!-- content in the first column (UGC padding) -->
      <div class="reveal reveal-fade flex flex-col items-start justify-start self-start px-[max(22px,5%)] pb-16 sm:px-0 lg:px-12 lg:pb-24">
        <Logo variant="light" class="h-8" />
        <p class="mt-6 text-[23px] font-display font-normal tracking-[0.025em] text-on-dark">
          contact@rightskit.com
        </p>
        <p class="text-body mt-6 max-w-[440px] text-[16px] font-[330] text-pretty text-on-dark-muted opacity-90 max-sm:leading-[25px]">
          Our data tools and network of trusted partners help rightsholders
          uncover the true value of their catalog. Take control of your data and
          unlock untapped revenue today.
        </p>
        <CtaButton class="mt-8 w-fit">Get in touch</CtaButton>
      </div>
    </div>

    <p class="text-small mt-12 px-[max(22px,5%)] pb-12 text-left font-extralight text-on-dark-muted sm:px-0 lg:mt-20">
      © 2025 RightsKit. All rights reserved
    </p>
  </div>

  <!-- Giant wordmark, constrained to 1360; bottom ~1/4 clipped by the box so it
       runs off the bottom of the page. Logo aspect 177:37 → show 3/4 height. -->
  <div class="container-site px-[max(22px,5%)] sm:px-0" aria-hidden="true">
    <div class="overflow-hidden" style="aspect-ratio: 177 / 24;">
      <div class="[&>svg]:block [&>svg]:h-auto [&>svg]:w-full" set:html={lightLogo}>
      </div>
    </div>
  </div>
</footer>
