---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span
  class:list={[
    "inline-flex items-center bg-surface px-3 py-1.5 font-plex text-[0.6875rem] font-[350] tracking-widest text-brand uppercase max-[376px]:w-full max-[376px]:justify-center",
    className,
  ]}
>
  <slot />
</span>
