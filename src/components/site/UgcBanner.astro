---
import { Image } from "astro:assets";
import CtaButton from "./CtaButton.astro";
import bannerBg from "@/assets/media/rightskit-ugc-banner-bg.png";
import bannerPhoto from "@/assets/media/rightskit-ugc-banner-photo.png";
import bannerMobile from "@/assets/media/rightskit-ugc-banner-mobile.png";

const body =
  "Identify unauthorized commercial sync uses of your catalog on UGC platforms. Through our managed service and trusted-partner network, we recover revenue that was previously out of reach. Bring your own data and supercharge your existing efforts, or unlock an entirely new revenue stream.";
---

<!-- Constrained banner. Photo is a free background layer on the right (not a
     rigid column), so it can scale/bleed; text sits on the left. -->
<section id="ugc" class="py-20 lg:py-[120px]">
  <div class="container-site">
    <div
      class="relative isolate flex flex-col overflow-hidden text-on-dark lg:min-h-[34rem] lg:flex-row lg:items-center"
    >
      <!-- gradient / texture background -->
      <Image
        src={bannerBg}
        alt=""
        aria-hidden="true"
        class="absolute inset-0 -z-20 h-full w-full object-cover"
        widths={[768, 1280, 1600]}
        sizes="(max-width: 1360px) 100vw, 1360px"
        quality={45}
      />

      <!-- photo. Below lg: a full-width band ABOVE the text. At lg: background-
           right column with scroll parallax. -->
      <div class="relative h-[240px] w-full overflow-hidden sm:h-[300px] lg:absolute lg:inset-y-0 lg:right-0 lg:-z-10 lg:h-auto lg:w-[42%]">
        <!-- Mobile (<lg): a lightweight pre-cropped strip — a fraction of the
             full collage's weight. Hidden (never fetched) on desktop. -->
        <Image
          src={bannerMobile}
          alt=""
          aria-hidden="true"
          class="h-full w-full scale-105 object-cover object-center lg:hidden"
          widths={[480, 768, 1024]}
          sizes="100vw"
          quality={60}
          loading="lazy"
        />
        <!-- Desktop (lg+): the full tall collage, with scroll parallax. -->
        <div
          id="ugcParallax"
          class="hidden origin-left will-change-transform lg:absolute lg:inset-x-0 lg:-top-[54%] lg:block lg:h-[192%]"
        >
          <Image
            src={bannerPhoto}
            alt="Collage of user-generated content clips"
            class="h-full w-full object-cover object-top"
            widths={[500, 800, 1100]}
            sizes="48vw"
            quality={62}
            loading="lazy"
          />
        </div>
      </div>

      <!-- text -->
      <div class="relative w-full px-[max(22px,5%)] py-12 sm:px-8 md:px-12 lg:w-auto lg:max-w-[58%] lg:py-24">
        <p class="font-plex text-eyebrow font-[350] tracking-[0.2em] text-on-dark-muted uppercase">
          Unlicensed commercial sync
        </p>
        <h2 class="text-h2 mt-4 max-w-2xl font-normal tracking-[0.01em] text-pretty leading-[1.25] lg:text-[38px]">
          Now accepting clients for unlicensed commercial UGC sync services
        </h2>
        <p class="text-body mt-6 max-w-2xl font-[330] text-pretty text-on-dark-muted max-sm:text-[16px] max-sm:leading-[25px]">{body}</p>
        <CtaButton class="mt-8">Get in touch</CtaButton>
      </div>
    </div>
  </div>
</section>

<style>
</style>

<script>
  const img = document.getElementById("ugcParallax");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (img && !reduce) {
    let ticking = false;
    let visible = true;
    const update = () => {
      const r = img.getBoundingClientRect();
      const vh = window.innerHeight;
      const p = (r.top + r.height / 2 - vh / 2) / (vh / 2 + r.height / 2);
      // shift scales with the layer height: ~190px on the tall desktop column,
      // gently smaller on the short stacked band.
      const shift = Math.max(-1, Math.min(1, p)) * -(img.offsetHeight * 0.19);
      // no zoom on desktop (the h-192% overflow already gives the parallax its
      // travel); keep a little zoom on the short mobile band so its smaller
      // translate doesn't reveal an edge.
      const zoom = window.innerWidth >= 1024 ? 1 : 1.1;
      img.style.transform = `translateY(${shift}px) scale(${zoom})`;
      ticking = false;
    };
    const onScroll = () => {
      if (visible && !ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    // Only listen/compute while the banner section is on screen.
    const section = img.closest("section");
    if (section && "IntersectionObserver" in window) {
      new IntersectionObserver(([e]) => {
        visible = e.isIntersecting;
        if (visible) update();
      }).observe(section);
    }
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    update();
  }
</script>
