---
import { Image } from "astro:assets";
import CtaButton from "./CtaButton.astro";
import bannerBg from "@/assets/media/rightskit-ugc-banner-bg.png";
import bannerPhoto from "@/assets/media/rightskit-ugc-banner-photo.png";

const body =
  "Monitoring and enforcement of unauthorized commercial sync on UGC platforms. Through our managed service and trusted-partner network, we recover revenue that was previously out of reach. Bring your own data and supercharge your existing efforts, or unlock an entirely new revenue stream.";
---

<!-- Constrained banner. Photo is a free background layer on the right (not a
     rigid column), so it can scale/bleed; text sits on the left. -->
<section class="py-20 lg:py-28">
  <div class="container-site">
    <div
      class="relative isolate flex flex-col overflow-hidden text-on-dark lg:min-h-[34rem] lg:flex-row lg:items-center"
    >
      <!-- gradient / texture background -->
      <Image
        src={bannerBg}
        alt=""
        aria-hidden="true"
        class="absolute inset-0 -z-20 h-full w-full object-cover"
        widths={[768, 1280, 1600]}
        sizes="(max-width: 1360px) 100vw, 1360px"
      />

      <!-- photo. Below lg: a full-width band ABOVE the text. At lg: background-
           right column with scroll parallax. -->
      <div class="relative h-[240px] w-full overflow-hidden sm:h-[300px] lg:absolute lg:inset-y-0 lg:right-0 lg:-z-10 lg:h-auto lg:w-[42%]">
        <!-- Parallax layer: holds the image AND the sound-wave overlays so the
             waves travel with the photo. Positions are % of this layer. -->
        <div
          id="ugcParallax"
          class="absolute inset-x-0 top-0 h-full w-full origin-center will-change-transform lg:-top-[54%] lg:h-[192%] lg:origin-left"
        >
          <Image
            src={bannerPhoto}
            alt="Collage of user-generated content clips"
            class="h-full w-full origin-center object-cover object-center max-lg:scale-[1.2] lg:object-top"
            widths={[500, 800, 1100]}
            sizes="(max-width: 1024px) 100vw, 48vw"
          />
          {
            /* One equaliser per phone, sitting on its music-note line. */
            [
              { left: "57%", top: "4%" },
              { left: "23%", top: "20%" },
              { left: "94%", top: "20%" },
              { left: "59%", top: "39%" },
              { left: "23%", top: "56%" },
              { left: "94%", top: "57.5%" },
            ].map((p) => (
              <div
                class="ugc-wave pointer-events-none absolute"
                style={`left:${p.left};top:${p.top}`}
                aria-hidden="true"
              >
                <span /><span /><span /><span /><span />
              </div>
            ))
          }
        </div>
      </div>

      <!-- text -->
      <div class="relative w-full px-[max(22px,5%)] py-12 sm:px-8 md:px-12 lg:w-auto lg:max-w-[58%] lg:py-24">
        <p class="font-plex text-eyebrow font-[350] tracking-[0.2em] text-on-dark-muted uppercase">
          Unlicensed commercial sync
        </p>
        <h2 class="text-h2 mt-4 max-w-2xl font-normal tracking-[0.01em] text-pretty leading-[1.25] lg:text-[38px]">
          Now accepting clients for unlicensed commercial UGC sync services
        </h2>
        <p class="text-body mt-6 max-w-2xl font-[330] text-pretty text-on-dark-muted max-sm:text-[16px] max-sm:leading-[25px]">{body}</p>
        <CtaButton class="mt-8">Get started</CtaButton>
      </div>
    </div>
  </div>
</section>

<style>
  /* Animated equaliser overlaid on each phone's music line. Sized as % of the
     parallax layer so it scales/moves with the photo. */
  .ugc-wave {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 1.1%;
    width: 3.4%;
    transform: translateX(-5px);
  }
  .ugc-wave span {
    flex: 1 1 0;
    height: 100%;
    transform: scaleY(0.25);
    transform-origin: bottom;
    background: #fffffb;
    border-radius: 1px;
    animation: ugc-wave 900ms ease-in-out infinite;
  }
  .ugc-wave span:nth-child(2) { animation-delay: 0.12s; }
  .ugc-wave span:nth-child(3) { animation-delay: 0.24s; }
  .ugc-wave span:nth-child(4) { animation-delay: 0.36s; }
  .ugc-wave span:nth-child(5) { animation-delay: 0.48s; }
  /* animate transform (composited) not height (forces layout every frame) */
  @keyframes ugc-wave {
    0%, 100% { transform: scaleY(0.25); }
    50% { transform: scaleY(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ugc-wave span { animation: none; transform: scaleY(0.6); }
  }
  /* waves are positioned for the tall desktop column — hide on the stacked band */
  @media (max-width: 1023px) {
    .ugc-wave { display: none; }
  }
</style>

<script>
  const img = document.getElementById("ugcParallax");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (img && !reduce) {
    let ticking = false;
    let visible = true;
    const update = () => {
      const r = img.getBoundingClientRect();
      const vh = window.innerHeight;
      const p = (r.top + r.height / 2 - vh / 2) / (vh / 2 + r.height / 2);
      // shift scales with the layer height: ~190px on the tall desktop column,
      // gently smaller on the short stacked band.
      const shift = Math.max(-1, Math.min(1, p)) * -(img.offsetHeight * 0.19);
      img.style.transform = `translateY(${shift}px) scale(1.1)`;
      ticking = false;
    };
    const onScroll = () => {
      if (visible && !ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    // Only listen/compute while the banner section is on screen.
    const section = img.closest("section");
    if (section && "IntersectionObserver" in window) {
      new IntersectionObserver(([e]) => {
        visible = e.isIntersecting;
        if (visible) update();
      }).observe(section);
    }
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    update();
  }
</script>
