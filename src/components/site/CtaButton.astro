---
import { Button } from "@/components/starwind/button";

interface Props {
  href?: string;
  class?: string;
  variant?: "primary" | "outline" | "default" | "ghost" | "secondary";
  size?: "sm" | "md" | "lg";
  /** Opens the contact modal (default). Set false for a plain link button. */
  contact?: boolean;
}

const {
  href = "#contact",
  class: className,
  variant = "primary",
  size = "sm",
  contact = true,
} = Astro.props;
---

<Button
  as="a"
  href={href}
  variant={variant}
  size={size}
  data-contact={contact ? "" : undefined}
  class:list={[
    "cta-glow font-plex text-xs font-[350] tracking-widest uppercase",
    className,
  ]}
>
  <slot />
</Button>
