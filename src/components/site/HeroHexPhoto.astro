---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import detailsSvg from "@/assets/hero/ugc-panel-details-1.svg?raw";

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Overlay the "Fly Net Tennis" credit card + sound wave. */
  credit?: boolean;
  /** z-index / extra utilities on the absolutely-placed wrapper. */
  class?: string;
  /** left / top / width, e.g. "left:16%;top:60%;width:24.5%" */
  style?: string;
}

const { src, alt, credit = false, class: className, style } = Astro.props;
---

<div class:list={["hero-hex absolute", className]} style={style}>
  <div class="hero-hex-inner">
    <Image
      src={src}
      alt={alt}
      class="h-auto w-full"
      widths={[300, 500, 760]}
      sizes="(max-width: 1024px) 30vw, 26vw"
      loading="eager"
    />
    {
      credit && (
        <>
          <div class="credit-card pointer-events-none absolute" aria-hidden="true" set:html={detailsSvg} />
          <div class="sound-wave pointer-events-none absolute" aria-hidden="true">
            <span /><span /><span /><span /><span />
          </div>
        </>
      )
    }
  </div>
</div>

<style>
  /* 3D tilt — driven by cursor position (see script in Hero.astro) */
  .hero-hex {
    perspective: 900px;
  }
  .hero-hex-inner {
    transition: transform 140ms ease-out;
    transform-style: preserve-3d;
    will-change: transform;
  }

  /* Credit card sits on the lower-left of the hexagon body. */
  .credit-card {
    left: 8%;
    bottom: 30%;
    width: 55%;
  }
  .credit-card :global(svg) {
    display: block;
    height: auto;
    width: 100%;
  }

  /* Animated "sound wave" equaliser under the credit card */
  .sound-wave {
    left: 8%;
    bottom: 28.5%;
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 6.5%;
    width: 12%;
  }
  .sound-wave span {
    flex: 0 0 6px;
    height: 100%;
    transform: scaleY(0.25);
    transform-origin: bottom;
    background: #fffffb;
    border-radius: 1px;
    animation: sound-wave 900ms ease-in-out infinite;
  }
  .sound-wave span:nth-child(2) {
    animation-delay: 0.12s;
  }
  .sound-wave span:nth-child(3) {
    animation-delay: 0.24s;
  }
  .sound-wave span:nth-child(4) {
    animation-delay: 0.36s;
  }
  .sound-wave span:nth-child(5) {
    animation-delay: 0.48s;
  }
  /* animate transform (composited) not height (forces layout every frame) */
  @keyframes sound-wave {
    0%,
    100% {
      transform: scaleY(0.25);
    }
    50% {
      transform: scaleY(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sound-wave span {
      animation: none;
      transform: scaleY(0.6);
    }
    .credit-card,
    .sound-wave {
      animation: none;
    }
  }
</style>
