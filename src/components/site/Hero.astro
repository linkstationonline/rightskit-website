---
import CtaButton from "./CtaButton.astro";
import HeroHexPhoto from "./HeroHexPhoto.astro";
import womanImg from "@/assets/hero/ugc-panel-1.png";
import tennisImg from "@/assets/hero/ugc-panel-2.png";
import bagImg from "@/assets/hero/ugc-panel-3.png";
import shoeImg from "@/assets/hero/ugc-panel-4.png";
// Per-photo credit cards: FLY (tennis), Tonic (bag + woman), Empire (shoe).
import detailFly from "@/assets/hero/ugc-panel-details-0.svg?url";
import detailEmpire from "@/assets/hero/ugc-panel-details-2.svg?url";
import detailTonic from "@/assets/hero/ugc-panel-details-3.svg?url";
import detailBagCard from "@/assets/hero/ugc-panel-details-4.svg?url";

const body =
  "Our data tools and trusted partners help rightsholders uncover the true value of their catalog. Take control of your data and unlock untapped revenue today.";

// 4-image cycle (index i·mod·4). Both the desktop conveyor and the mobile row
// repeat this every 4, so a translate of one 4-step period loops seamlessly.
const CYCLE = [
  { img: womanImg, detail: detailTonic, alt: "Woman on rocks by the sea" },
  { img: shoeImg, detail: detailEmpire, alt: "Running shoes on a track" },
  { img: bagImg, detail: detailBagCard, alt: "Black leather tote bag" },
  { img: tennisImg, detail: detailFly, alt: "Tennis player mid-serve" },
];
const cyc = (k: number) => CYCLE[((k % 4) + 4) % 4];
// Desktop: rising diagonal, step = +21.5% x / -29% y.
const conveyorHexes = Array.from({ length: 12 }, (_, i) => {
  const k = i - 2;
  return { ...cyc(k), left: -33 + 21.5 * k, top: 146 - 29 * k, z: i + 1 };
});
// Mobile: horizontal row, step = 47%.
// Drift is rightward by one 4-image period (188%). Extend the band well to the
// LEFT (the trailing side) so a hex is always entering as one exits right, and
// the period-exact loop makes the wrap seamless (no blank gap).
const rowHexes = Array.from({ length: 14 }, (_, n) => {
  const i = n - 8;
  return { ...cyc(i), left: 47 * i };
});
---

<section
  id="hero"
  class="relative overflow-hidden border-b border-neutral-300 bg-surface min-h-[calc(100svh-137px)]"
>
  <!-- Copy (container is click-through so the hexes behind it stay hoverable) -->
  <div class="container-site pointer-events-none relative z-40 px-[max(22px,5%)] py-10 sm:px-0 max-lg:pt-20 lg:py-14 lg:max-[1280px]:-translate-y-[6%]">
    <div class="pointer-events-auto lg:max-w-xl lg:pt-14">
      <h1 class="text-h1 -ml-[3px] font-[390] tracking-[-0.015em] text-ink">Your rights<span class="lg:hidden"> </span><br class="hidden lg:inline" /><span class="whitespace-nowrap">data toolkit</span></h1>
      <p class="mt-6 max-w-[480px] text-[16px] leading-[25px] font-[380] text-pretty text-ink-muted">{body}</p>
      <CtaButton class="mt-8">See a demo</CtaButton>
    </div>

  </div>

  <!-- Mobile / tablet (<lg): a horizontal row of hexes running under the copy,
       drifting left. Images repeat every 3 so a translate of one period loops. -->
  <div class="relative mt-8 h-[max(60vw,340px)] w-full overflow-hidden lg:hidden">
    <div class="hex-row absolute inset-y-0 left-0 w-[max(100%,610px)]">
      {
        rowHexes.map((h) => (
          <HeroHexPhoto src={h.img} credit eager detail={h.detail} alt={h.alt} style={`left:${h.left}%;top:0;width:46%`} />
        ))
      }
    </div>
  </div>

  <!-- Desktop cluster (lg+): hexagons on a rising diagonal, drifting up-right.
       4-image cycle → a translate of one 4-step period loops seamlessly. -->
  <div class="hidden lg:block lg:absolute lg:inset-0 z-10">
    <div class="relative mx-auto h-full w-full max-w-[1920px] lg:translate-x-[clamp(0px,92px-6vw,46px)] lg:translate-y-[clamp(0px,254px-16.5vw,127px)]">
      <div class="hex-conveyor absolute left-[4%] -top-[14%] aspect-[1440/704] w-[clamp(100%,calc(100%+(1536px-100vw)*0.3),140%)]">
      {
        conveyorHexes.map((h) => (
          <HeroHexPhoto src={h.img} credit detail={h.detail} alt={h.alt} style={`left:${h.left}%;top:${h.top}%;width:28.6%;z-index:${h.z}`} />
        ))
      }
      </div>
    </div>
  </div>
</section>

<style>
  .hex-conveyor {
    animation: hex-drift 80s linear infinite;
    /* own compositor layer so the mask composites it without repainting the
       9 images every frame */
    will-change: transform;
  }
  /* mobile horizontal row: drift left by one 3-image period (3 × 29%) */
  .hex-row {
    animation: hex-row-drift 60s linear infinite;
    will-change: transform;
  }
  @keyframes hex-row-drift {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(188%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hex-row {
      animation: none;
    }
  }
  /* paused when the hero is scrolled out of view (toggled from JS) */
  .hex-conveyor.is-paused {
    animation-play-state: paused;
  }
  /* one 3-step period: +64.5% x, -87% y (each step is +21.5% / -29%) */
  @keyframes hex-drift {
    from {
      transform: translate(0, 0);
    }
    to {
      transform: translate(86%, -116%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hex-conveyor {
      animation: none;
    }
  }
</style>

<script>
  // Cursor-reactive 3D tilt. A rAF loop reads each hexagon's LIVE position so the
  // tilt stays correct while they drift; only the topmost hovered hex tilts.
  const hero = document.getElementById("hero");
  // Fill exactly the viewport minus whatever sits above the hero (announcement
  // bar + sticky nav). offsetTop = their combined height, so this stays correct
  // at every breakpoint (the announcement bar is taller when it stacks on mobile).
  if (hero) {
    // Fill the viewport under the bars, but never taller than 0.8× the width
    // (so it doesn't become a super-long panel on portrait phones/tablets).
    const fit = () =>
      hero.style.setProperty(
        "min-height",
        `min(calc(100svh - ${hero.offsetTop}px), 80vw, 1100px)`,
      );
    fit();
    window.addEventListener("resize", fit);
  }
  // Pause the drifting conveyor whenever the hero is off-screen so it isn't
  // burning GPU/compositing while you're reading the rest of the page.
  const conveyor = hero?.querySelector<HTMLElement>(".hex-conveyor");
  if (hero && conveyor && "IntersectionObserver" in window) {
    new IntersectionObserver(
      ([e]) => conveyor.classList.toggle("is-paused", !e.isIntersecting),
    ).observe(hero);
  }
  if (hero) {
    // desktop conveyor only — the mobile horizontal row (.hex-row) gets no tilt
    const hexes = Array.from(
      hero.querySelectorAll<HTMLElement>(".hex-conveyor .hero-hex"),
    ).map((el) => ({ el, inner: el.querySelector<HTMLElement>(".hero-hex-inner") }));
    let mx: number | null = null;
    let my: number | null = null;
    let raf = 0;

    const tick = () => {
      const rects = hexes.map((h) => h.el.getBoundingClientRect());
      let top = -1;
      if (mx !== null && my !== null) {
        rects.forEach((r, i) => {
          if (mx! >= r.left && mx! <= r.right && my! >= r.top && my! <= r.bottom)
            top = i;
        });
      }
      hexes.forEach((h, i) => {
        if (!h.inner) return;
        if (i === top) {
          const r = rects[i];
          const px = (mx! - r.left) / r.width - 0.5;
          const py = (my! - r.top) / r.height - 0.5;
          h.inner.style.transform = `rotateX(${(-py * 18).toFixed(1)}deg) rotateY(${(px * 18).toFixed(1)}deg)`;
        } else {
          h.inner.style.transform = "";
        }
      });
      raf = mx === null ? 0 : requestAnimationFrame(tick);
    };

    hero.addEventListener("pointermove", (e) => {
      mx = e.clientX;
      my = e.clientY;
      if (!raf) raf = requestAnimationFrame(tick);
    });
    hero.addEventListener("pointerleave", () => {
      mx = my = null;
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
      hexes.forEach((h) => h.inner && (h.inner.style.transform = ""));
    });
  }
</script>
