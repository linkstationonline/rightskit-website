---
import CtaButton from "./CtaButton.astro";
import HexMark from "./HexMark.astro";
import ServiceRow from "./ServiceRow.astro";

const lead =
  "Supercharge your existing efforts or uncover new revenue opportunities with our managed services.";
const rowBody =
  "Our data tools and network of trusted partners help rightsholders uncover the true value of their catalog. Take control of your data and unlock untapped revenue today.";
// Inline Lucide icons (MIT). 24x24 stroke icons; sized/coloured via ServiceRow.
const svg = (paths: string) =>
  `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${paths}</svg>`;
const icons = {
  // search (magnifying glass)
  audit: svg('<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>'),
  // check
  managed: svg('<path d="M20 6 9 17l-4-4"/>'),
  // play
  sync: svg('<polygon points="6 3 20 12 6 21 6 3"/>'),
};
const rows = [
  {
    title: "Data audits",
    icon: icons.audit,
    body: "Find inconsistencies, missing information and incorrect catalog registrations with our metadata tools and audit. Fix data leaks, uncover new connections and get your royalties flowing to the right places.",
    tags: ["Royalty audit", "Metadata", "Data matching"],
  },
  {
    title: "Managed rights",
    icon: icons.managed,
    body: "Complement your in-house efforts or unlock an entirely new revenue stream with our bolt-on managed services. Increase your reach, supercharge your throughput and get more from your catalog.",
    tags: ["Sync licensing", "Administration", "Enforcement"],
  },
  {
    title: "Sync monitoring",
    icon: icons.sync,
    body: "Identify unlicensed and unauthorized commercial sync uses of your catalog across digital platforms. Recover revenue via retroactive licensing and fee resolution.",
    tags: ["Unauthorized UGC", "Retroactive sync", "Revenue recovery"],
  },
];
---

<!-- Constrained split: navy/grey live INSIDE the 1360 container; the area outside
     the container stays white (page background). -->
<section
  id="services"
  class="mt-16 border-y border-neutral-200 lg:mt-[120px]"
  style="background-color:#fffffb;background-image:radial-gradient(rgba(26,30,58,0.13) 1.3px, transparent 1.3px);background-size:15px 15px;"
>
  <div class="container-site grid grid-cols-1 border-x border-neutral-200 lg:grid-cols-2">
    <!-- Left: dark intro. Navy fills the full column height; the inner content
         pins to the top of the viewport while the grey rows scroll past, then
         rides out with the section. (sticky works because <body> is overflow-x: clip.) -->
    <div class="bg-surface-dark text-on-dark">
      <div
        class="px-[max(22px,5%)] pt-12 pb-16 sm:px-8 md:px-12 lg:sticky lg:top-[76px] lg:pt-24 lg:pr-12 lg:pb-40"
      >
        <HexMark variant="outline" class="h-28" />
        <div class="mt-4 lg:mt-5">
          <h2 class="text-h2 max-w-sm font-normal tracking-[0.02em] leading-[1.25] lg:text-[clamp(34px,24.2px+0.96vw,38px)]">
            Bolt-on services,<br />when you need them
          </h2>
          <p class="mt-6 max-w-md text-[18px] leading-[27px] font-[330] text-pretty text-on-dark-muted opacity-90 max-sm:text-[16px] max-sm:leading-[25px]">{lead}</p>
          <CtaButton class="mt-8">Find out more</CtaButton>
        </div>
      </div>
    </div>

    <!-- Right: grey rows (row dividers span the full column width) -->
    <div class="bg-[#fcfbfa] text-ink">
      {
        rows.map((r, i) => (
          <ServiceRow
            title={r.title}
            body={r.body ?? rowBody}
            tags={r.tags}
            icon={r.icon}
            index={i}
            class={i > 0 ? "border-t border-ink/10" : ""}
          />
        ))
      }
    </div>
  </div>
</section>
