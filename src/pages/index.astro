---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AnnouncementBar from "@/components/site/AnnouncementBar.astro";
import SiteHeader from "@/components/site/SiteHeader.astro";
import Hero from "@/components/site/Hero.astro";
import ServicesSection from "@/components/site/ServicesSection.astro";
import UgcBanner from "@/components/site/UgcBanner.astro";
import ValueCta from "@/components/site/ValueCta.astro";
import SiteFooter from "@/components/site/SiteFooter.astro";
import Block from "@/components/site/Block.astro";
---

<BaseLayout>
  <AnnouncementBar />
  <SiteHeader />
  <main id="main-content">
    <Hero />
    <ServicesSection />
    <UgcBanner />
    <ValueCta />
  </main>

  <!-- full-width purple strip -->
  <div class="h-8 w-full bg-brand"></div>

  <SiteFooter />
</BaseLayout>
