---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/site/SiteHeader.astro";
import SiteFooter from "@/components/site/SiteFooter.astro";
import HexMark from "@/components/site/HexMark.astro";
import CtaButton from "@/components/site/CtaButton.astro";
import ContactModal from "@/components/site/ContactModal.astro";
---

<BaseLayout title="Page not found — RightsKit" description="The page you're looking for doesn't exist.">
  <SiteHeader />
  <main id="main-content" class="container-site flex min-h-[60svh] flex-col items-center justify-center px-[max(22px,5%)] py-24 text-center sm:px-0">
    <HexMark variant="dark" class="h-14" />
    <p class="mt-8 font-plex text-eyebrow font-[350] tracking-[0.2em] text-brand uppercase">
      Error 404
    </p>
    <h1 class="mt-3 text-h1 font-[390] tracking-[-0.015em] text-ink">
      Page not found
    </h1>
    <p class="mt-5 max-w-[440px] text-[17px] leading-[27px] font-[380] text-pretty text-ink-muted">
      The page you're looking for doesn't exist or has moved. Let's get you back on track.
    </p>
    <CtaButton href="/" contact={false} class="mt-9">Back to home</CtaButton>
  </main>

  <div class="h-8 w-full bg-brand"></div>
  <SiteFooter />
  <ContactModal />
</BaseLayout>
